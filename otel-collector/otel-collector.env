# OpenLLMetry Environment Configuration
# 
# Environment variables for OpenLLMetry/OpenTelemetry telemetry

# OpenTelemetry Configuration
ENABLE_OPENTELEMETRY=true
OTEL_SERVICE_NAME=answers-agent
OTEL_SERVICE_VERSION=0.1.0
OTEL_ENVIRONMENT=development

# Exporters
OTEL_EXPORTER_JAEGER_ENDPOINT=http://jaeger:14268/api/traces
OTEL_EXPORTER_PROMETHEUS_PORT=8889
OTEL_ENABLE_TRACING=true
OTEL_ENABLE_METRICS=true
OTEL_TRACE_SAMPLE_RATE=1.0

# OpenLLMetry/Traceloop Configuration (optional - for cloud/self-hosted)
# TRACELOOP_API_KEY=your_api_key_here
# TRACELOOP_BASE_URL=http://localhost:3000
TRACELOOP_DISABLE_BATCH=true
TRACELOOP_APP_NAME=answers-agent
TRACELOOP_TELEMETRY=false

# Disable Langfuse during migration
ENABLE_LANGFUSE_TRACKING=false

# Reduce OpenTelemetry Collector logging
OTEL_LOG_LEVEL=warn
