
#MY_OTEL_ENABLE_TRACING=false
#MY_OTEL_ENABLE_METRICS=false
#MY_OTEL_ENABLE_INSTRUMENT=false

## DEBUGGER_LISTEN=true

USE_UNSTRUCTURED_API=false

CHAT_LLM_TYPE=openai
LLM_HAS_STRUCTURED_OUTPUT=true

LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_PROJECT=

#

ANSWERS_POSTGRES_DATABASE=answers
ANSWERS_POSTGRES_USER_NAME=answers
VECTORS_POSTGRES_USER_NAME=answers_vectors
CHECKPOINTS_POSTGRES_USER_NAME=answers_checkpoints

#

MINIO_ENDPOINT_URL=http://minio:9000
ANSWERS_MINIO_BUCKET=documents
ANSWERS_MINIO_USER_NAME=answers

# See https://langfuse.com/docs/sdk/python/low-level-sdk
#
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_FLUSH_INTERVAL=15

CELERY_FLOWER_USER_NAME=celery-flower

CELERY_TASK_QUEUE=answers_tasks
CELERY_RESULT_KEY_PREFIX=answers_results_

WEAVIATE_HOST=weaviate
WEAVIATE_HTTP_PORT=25080
WEAVIATE_GRPC_PORT=25051

# OpenTelemetry configuration for metrics and traces
OTEL_METRIC_EXPORTER=prometheus
OTEL_EXPORTER_JAEGER_ENDPOINT=http://otel-collector:14268/api/traces
# If you ever use OTLP, set the endpoint like this:
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://otel-collector:4318
