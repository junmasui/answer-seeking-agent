<clickhouse>
    <profiles>
        <default>
            <!-- https://clickhouse.com/docs/en/operations/tips#ram -->
            <max_block_size>1024</max_block_size>
            <max_download_threads>1</max_download_threads>
            <input_format_parallel_parsing>0</input_format_parallel_parsing>
            <output_format_parallel_formatting>0</output_format_parallel_formatting>

            <!-- additional tuning
            https://stackoverflow.com/questions/78645493/clickhouse-on-low-memory-machine
            -->

            <max_threads>3</max_threads>

            <max_memory_usage>7516192768</max_memory_usage>


            <max_bytes_before_external_group_by>1024000</max_bytes_before_external_group_by>
            <max_bytes_before_external_sort>1024000</max_bytes_before_external_sort>

        </default>
    </profiles>
</clickhouse>
