#
##APPLICATION_API_KEY_USER_ID_1=
APPLICATION_API_KEY_SCOPE_1=admin

##APPLICATION_API_KEY_USER_ID_2=
APPLICATION_API_KEY_SCOPE_2=query doc:read prompt:read

##APPLICATION_API_KEY_USER_ID_3=
