# For OpenTelemetry-specific environment variables
# see https://opentelemetry.io/docs/specs/otel/configuration/sdk-environment-variables/
# see https://opentelemetry-python.readthedocs.io/en/latest/sdk/environment_variables.html

# Service identification
OTEL_SERVICE_NAME="celery_worker"
OTEL_RESOURCE_ATTRIBUTES="service.name=celery_worker,service.version=1.0.0,deployment.environment=test"

OTEL_PYTHON_DISABLED_INSTRUMENTATIONS=transformers

# Exporter configuration  
OTEL_TRACES_EXPORTER="otlp"
OTEL_METRICS_EXPORTER="otlp"
OTEL_LOGS_EXPORTER="none"
# OTEL_LOGS_EXPORTER="otlp"

OTEL_EXPORTER_JAEGER_ENDPOINT=http://otel-collector:14268/api/traces

# # OTLP endpoints (gRPC)
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT="http://otel-collector:4317"
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT="http://otel-collector:4317"
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT="http://otel-collector:4317"
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# OTLP endpoints (HTTP)
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT="http://otel-collector:4318/v1/traces"
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT="http://otel-collector:4318/v1/metrics"
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT="http://otel-collector:4318/v1/logs"
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# OTEL_PYTHON_LOGGER_PROVIDER
# OTEL_PYTHON_METER_PROVIDER
# OTEL_PYTHON_TRACER_PROVIDER

# Sampling configuration
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG="0.1"  # Sampling rate


# Batch span processing
OTEL_BSP_SCHEDULE_DELAY="2000"
OTEL_BSP_MAX_EXPORT_BATCH_SIZE="128"

# Batch LogRecord processing
OTEL_BLRP_MAX_QUEUE_SIZE="128"
OTEL_BLRP_MAX_EXPORT_BATCH_SIZE="64"

# Optional: Enable log correlation
OTEL_PYTHON_LOG_CORRELATION="true"
OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED="true"

OTEL_INSTRUMENTATION_HTTP_CAPTURE_HEADERS_SERVER_REQUEST=".*"
