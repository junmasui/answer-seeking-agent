{
    "configurations": [
        {
            "name": "Python Debugger: Remote Attach",
            "type": "debugpy",
            "request": "attach",
            "justMyCode": false,
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "."
                }
            ],
            "autoReload": {
                "enable": true,
                "exclude": [
                    "**/.git/**",
                    "**/__pycache__/**",
                    "**/node_modules/**",
                    "**/.metadata/**",
                    "**/site-packages/**"
                ],
                "include": [
                    "**/*.py",
                    "**/*.pyw"
                ]
            }
        }
    ]
}