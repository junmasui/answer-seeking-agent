{
    "name": "Dev Server",
    "dockerComposeFile": [
        "../services/dev-server/deploy/common.compose.yml",
        "../services/dev-server/deploy/cuda.compose.yml"
    ],
    // Adds *default* settings.json values into a container/machine specific settings file.
    "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
    },
    "service": "dev-server",
    "workspaceFolder": "/app",
    "shutdownAction": "none",
    "extensions": [
        "ms-python.vscode-pylance",
        "ms-python.python",
        "ms-python.debugpy",
        "tamasfe.even-better-toml",
        "vue.volar",
        "dbaeumer.vscode-eslint"
    ],
    "remoteEnv": {},
    "remoteUser": "python"
}