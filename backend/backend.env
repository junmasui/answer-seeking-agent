
USE_UNSTRUCTURED_API=false

CHAT_LLM_TYPE=openai
LLM_HAS_STRUCTURED_OUTPUT=true

LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_PROJECT=

MINIO_ENDPOINT_URL=http://minio:9000
BACKEND_MINIO_BUCKET=documents
BACKEND_MINIO_USER_NAME=answers

REDIS_URL=redis://redis:6379/0

BACKEND_POSTGRES_USER_NAME=answers
POSTGRES_CONNECTION_URL="postgresql+psycopg://${BACKEND_POSTGRES_USER_NAME}:${BACKEND_POSTGRES_USER_PASSWORD}@pgvector:5432/answers"

# See https://langfuse.com/docs/sdk/python/low-level-sdk
#
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_FLUSH_INTERVAL=15
